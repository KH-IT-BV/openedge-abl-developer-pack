# APM build output (generated by `apm install` / `apm compile` / `apm pack`) — never commit
apm_modules/
build/
.claude/
.claude-plugin/
.cursor/
.codex/

# Keep apm.lock.yaml committed (pins resolved sources + hashes) — do NOT ignore it.

# Local, machine-specific MCP test artifacts (absolute paths / local connections) — never commit.
# The committed source of truth is mcp.json (uses ${OEDP_MCP_HOME}) + connections.example.json.
*.mcp.local.json
mcp-servers/**/connections.json
mcp-servers/**/servers.json
mcp-servers/**/secrets.json
mcp-servers/test-issue-*.md
